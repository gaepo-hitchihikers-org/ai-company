{
    // ===========================
    // 개포히치하이커스 — OpenClaw 설정
    // ===========================
    // 에이전트당 1개 Discord Bot = 8개 독립 봇이 Discord에서 실제 팀처럼 소통
    // 모델: OpenAI Codex OAuth (구독 기반)

    "agents": {
        "defaults": {
            "model": {
                "primary": "openai-codex/gpt-5.3-codex",
                "fallbacks": ["openai-codex/gpt-5.1-codex-mini"]
            },
            "contextTokens": 200000,
            "models": {
                "openai-codex/gpt-5.3-codex": { "alias": "codex" },
                "openai-codex/gpt-5.2-codex": { "alias": "codex52" },
                "openai-codex/gpt-5.1-codex-mini": { "alias": "mini" },
                "openai-codex/gpt-5.1-codex-max": { "alias": "max" },
                "openai-codex/gpt-5.2": { "alias": "gpt52" },
                "openai-codex/gpt-5.1": { "alias": "gpt51" }
            },
            "sandbox": {
                "mode": "off"
            }
        },

        "list": [
            // ─── PM_Agent ───
            {
                "id": "pm",
                "default": true,
                "workspace": "~/.openclaw/workspaces/pm",
                "agentDir": "~/.openclaw/agents/pm/agent",
                "model": {
                    "primary": "openai-codex/gpt-5.2",
                    "fallbacks": ["openai-codex/gpt-5.1-codex-mini"]
                },
                "identity": { "name": "PM_Thunder" },
                "tools": {
                    "allow": ["exec", "read", "write", "edit", "browser", "message"]
                },
                "groupChat": {
                    "mentionPatterns": ["<@1471753697628520522>", "<@!1471753697628520522>"]
                }
            },

            // ─── Frontend_Agent ───
            {
                "id": "frontend",
                "workspace": "~/.openclaw/workspaces/frontend",
                "agentDir": "~/.openclaw/agents/frontend/agent",
                "model": {
                    "primary": "openai-codex/gpt-5.3-codex"
                },
                "identity": { "name": "FE_Gaeulee" },
                "tools": {
                    "allow": ["exec", "process", "read", "write", "edit", "browser", "message"]
                },
                "groupChat": {
                    "mentionPatterns": ["<@1471757333494497331>", "<@!1471757333494497331>"]
                }
            },

            // ─── Backend_Agent ───
            {
                "id": "backend",
                "workspace": "~/.openclaw/workspaces/backend",
                "agentDir": "~/.openclaw/agents/backend/agent",
                "model": {
                    "primary": "openai-codex/gpt-5.3-codex",
                    "fallbacks": ["openai-codex/gpt-5.1-codex-mini"]
                },
                "identity": { "name": "BE_Blue" },
                "tools": {
                    "allow": ["exec", "process", "read", "write", "edit", "browser", "message"]
                },
                "groupChat": {
                    "mentionPatterns": ["<@1471758619648331878>", "<@!1471758619648331878>"]
                }
            },

            // ─── DevOps_Agent ───
            {
                "id": "devops",
                "workspace": "~/.openclaw/workspaces/devops",
                "agentDir": "~/.openclaw/agents/devops/agent",
                "model": {
                    "primary": "openai-codex/gpt-5.3-codex"
                },
                "identity": { "name": "DO_Bob" },
                "tools": {
                    "allow": ["exec", "process", "read", "write", "edit", "browser", "message"]
                },
                "groupChat": {
                    "mentionPatterns": ["<@1471760318664413398>", "<@!1471760318664413398>"]
                }
            },

            // ─── Security_Agent ───
            {
                "id": "security",
                "workspace": "~/.openclaw/workspaces/security",
                "agentDir": "~/.openclaw/agents/security/agent",
                "model": {
                    "primary": "openai-codex/gpt-5.3-codex"
                },
                "identity": { "name": "SE_Berman" },
                "tools": {
                    "allow": ["exec", "process", "read", "write", "browser", "message"]
                },
                "groupChat": {
                    "mentionPatterns": ["<@1471762405590564987>", "<@!1471762405590564987>"]
                }
            },

            // ─── Design_Agent ───
            {
                "id": "design",
                "workspace": "~/.openclaw/workspaces/design",
                "agentDir": "~/.openclaw/agents/design/agent",
                "model": {
                    "primary": "openai-codex/gpt-5.2"
                },
                "identity": { "name": "PD_Coco" },
                "tools": {
                    "allow": ["exec", "browser", "read", "write", "message"]
                },
                "groupChat": {
                    "mentionPatterns": ["<@1471763570139336922>", "<@!1471763570139336922>"]
                }
            },

            // ─── Research_Agent ───
            {
                "id": "research",
                "workspace": "~/.openclaw/workspaces/research",
                "agentDir": "~/.openclaw/agents/research/agent",
                "model": {
                    "primary": "openai-codex/gpt-5.2"
                },
                "identity": { "name": "GM_Abby" },
                "tools": {
                    "allow": ["exec", "browser", "read", "write", "message"]
                },
                "groupChat": {
                    "mentionPatterns": ["<@1471766532945088522>", "<@!1471766532945088522>"]
                }
            },

            // ─── QA_Agent ───
            {
                "id": "qa",
                "workspace": "~/.openclaw/workspaces/qa",
                "agentDir": "~/.openclaw/agents/qa/agent",
                "model": {
                    "primary": "openai-codex/gpt-5.3-codex"
                },
                "identity": { "name": "QA_Snow" },
                "tools": {
                    "allow": ["exec", "process", "read", "write", "edit", "browser", "message"]
                },
                "groupChat": {
                    "mentionPatterns": ["<@1471767984073605293>", "<@!1471767984073605293>"]
                }
            }
        ]
    },

    // ─── 바인딩: 에이전트 ↔ Discord 봇 계정 1:1 매핑 ───
    // 각 에이전트가 자신의 Discord Bot으로 메시지를 주고받음
    "bindings": [
        { "agentId": "pm",       "match": { "channel": "discord", "accountId": "pm" } },
        { "agentId": "frontend", "match": { "channel": "discord", "accountId": "frontend" } },
        { "agentId": "backend",  "match": { "channel": "discord", "accountId": "backend" } },
        { "agentId": "devops",   "match": { "channel": "discord", "accountId": "devops" } },
        { "agentId": "security", "match": { "channel": "discord", "accountId": "security" } },
        { "agentId": "design",   "match": { "channel": "discord", "accountId": "design" } },
        { "agentId": "research", "match": { "channel": "discord", "accountId": "research" } },
        { "agentId": "qa",       "match": { "channel": "discord", "accountId": "qa" } }
    ],

    // ─── Discord 설정: 에이전트당 1개 봇 ───
    "channels": {
        "discord": {
            "enabled": true,

            // 8개 Discord Bot 계정 (에이전트당 1개)
            // 각 Bot Token은 환경변수로 관리
            "accounts": {
                "pm":       {},
                "frontend": {},
                "backend":  {},
                "devops":   {},
                "security": {},
                "design":   {},
                "research": {},
                "qa":       {}
            },

            // 다른 봇의 메시지를 수신 (에이전트 간 Discord 소통의 핵심)
            "allowBots": true,

            "groupPolicy": "allowlist",
            "guilds": {
                // Discord 서버 ID — 실제 값으로 교체
                "1471749338538442958": {
                    // 모든 채널 requireMention: true — @mention된 봇만 응답
                    // 채널 권한 설정 없이도 안전 (모든 봇이 모든 채널에 있어도 OK)
                    "requireMention": true,
                    "channels": {
                        // #pm-strategy — PM 전용, 멘션 없이 응답
                        "1471753300507361302": {
                            "allow": true,
                            "requireMention": false
                        },
                        // #collab-bridge
                        "1471753344367333376": {
                            "allow": true
                        },
                        // #dev-log
                        "1471753374121590930": {
                            "allow": true
                        },
                        // #design-review
                        "1471753402471022683": {
                            "allow": true
                        },
                        // #alert
                        "1471753432498180096": {
                            "allow": true
                        }
                    }
                }
            },

            "dm": {
                "enabled": true,
                "policy": "pairing"
            },

            "historyLimit": 30,
            "replyToMode": "off"
        }
    },

    // ─── 세션 설정 ───
    "session": {
        "dmScope": "main"
    },

    // ─── 크론 설정 ───
    "cron": {
        "enabled": true,
        "maxConcurrentRuns": 2
    },

    // ─── 브라우저 기본 프로필 ───
    // Docker 환경에서는 로컬 Chrome 대신 browserless(CDP) 프로필을 기본 사용
    "browser": {
        "enabled": true,
        "defaultProfile": "browserless",
        "profiles": {
            "browserless": {
                "cdpUrl": "http://browser:3000",
                "color": "#00AA00"
            }
        }
    },

    // ─── Gateway 설정 ───
    "gateway": {
        "mode": "local",
        "auth": {
            "mode": "token",
            "token": ""
        }
    },

    // ─── 플러그인 ───
    "plugins": {
        "enabled": true,
        "entries": {
            "discord": { "enabled": true }
        }
    },

    // ─── 에이전트 간 직접 통신: 불필요 (Discord로 소통) ───
    "tools": {
        "agentToAgent": {
            "enabled": false
        }
    }
}
