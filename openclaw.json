{
    // ===========================
    // 개포히치하이커스 — OpenClaw 설정
    // ===========================
    // 멀티에이전트 + Slack 통신 + 모델 계층화

    "agents": {
        "defaults": {
            "model": {
                "primary": "google-antigravity/claude-sonnet-4-5",
                "fallbacks": ["google-antigravity/gemini-3-pro-high"]
            },
            "contextTokens": 50000,
            "models": {
                "google-antigravity/claude-sonnet-4-5": { "alias": "Sonnet" },
                "google-antigravity/gemini-3-pro-high": { "alias": "ProHigh" }
            },
            // 샌드박싱: 비-메인 세션은 Docker 샌드박스에서 실행
            "sandbox": {
                "mode": "off"
            }
        },

        "list": [
            // ─── PM_Agent: 매니저 ───
            {
                "id": "pm",
                "default": true,
                "workspace": "./workspaces/pm",
                "model": {
                    "primary": "google-antigravity/claude-sonnet-4-5",
                    "fallbacks": ["google-antigravity/claude-sonnet-4-5"]
                },
                "groupChat": {
                    "mentionPatterns": ["@PM", "@pm", "PM_Agent"]
                }
            },

            // ─── Frontend_Agent: 프론트엔드 개발자 ───
            {
                "id": "frontend",
                "workspace": "./workspaces/frontend",
                "model": {
                    "primary": "google-antigravity/gemini-3-pro-high"
                },
                "tools": {
                    "allow": ["exec", "process", "read", "write", "edit", "browser"]
                },
                "groupChat": {
                    "mentionPatterns": ["@Frontend", "@frontend", "Frontend_Agent"]
                }
            },

            // ─── Backend_Agent: 백엔드 개발자 ───
            {
                "id": "backend",
                "workspace": "./workspaces/backend",
                "model": {
                    "primary": "google-antigravity/claude-sonnet-4-5",
                    "fallbacks": ["google-antigravity/claude-sonnet-4-5"]
                },
                "tools": {
                    "allow": ["exec", "process", "read", "write", "edit"]
                },
                "groupChat": {
                    "mentionPatterns": ["@Backend", "@backend", "Backend_Agent"]
                }
            },

            // ─── DevOps_Agent: 인프라 & 배포 ───
            {
                "id": "devops",
                "workspace": "./workspaces/devops",
                "model": {
                    "primary": "google-antigravity/claude-sonnet-4-5"
                },
                "tools": {
                    "allow": ["exec", "process", "read", "write", "edit"]
                },
                "groupChat": {
                    "mentionPatterns": ["@DevOps", "@devops", "DevOps_Agent"]
                }
            },

            // ─── Security_Agent: 보안 ───
            {
                "id": "security",
                "workspace": "./workspaces/security",
                "model": {
                    "primary": "google-antigravity/claude-sonnet-4-5"
                },
                "tools": {
                    "allow": ["exec", "process", "read", "write"]
                },
                "groupChat": {
                    "mentionPatterns": ["@Security", "@security", "Security_Agent"]
                }
            },

            // ─── Design_Agent: 디자이너 ───
            {
                "id": "design",
                "workspace": "./workspaces/design",
                "model": {
                    "primary": "google-antigravity/gemini-3-pro-high"
                },
                "tools": {
                    "allow": ["browser", "read", "write"]
                },
                "groupChat": {
                    "mentionPatterns": ["@Design", "@design", "Design_Agent"]
                }
            },

            // ─── Research_Agent: 리서처 & 그로스 ───
            {
                "id": "research",
                "workspace": "./workspaces/research",
                "model": {
                    "primary": "google-antigravity/gemini-3-pro-high"
                },
                "tools": {
                    "allow": ["browser", "read", "write"]
                },
                "groupChat": {
                    "mentionPatterns": [
                        "@Research",
                        "@research",
                        "Research_Agent"
                    ]
                }
            },

            // ─── QA_Agent: 품질 관리 ───
            {
                "id": "qa",
                "workspace": "./workspaces/qa",
                "model": {
                    "primary": "google-antigravity/claude-sonnet-4-5"
                },
                "tools": {
                    "allow": ["exec", "process", "read", "write", "edit"]
                },
                "groupChat": {
                    "mentionPatterns": ["@QA", "@qa", "QA_Agent"]
                }
            }
        ]
    },

    // ─── Slack 채널 → 에이전트 바인딩 ───
    // ⚠️ peer.id에 실제 Slack 채널 ID를 입력하세요 (C로 시작하는 문자열)
    // Slack에서 채널 우클릭 → "Copy link" → URL 끝의 C... 부분이 채널 ID
    "bindings": [
        // ─── #collab-bridge: 전체 팀 (mentionPatterns로 라우팅) ───
        { "agentId": "pm",       "match": { "channel": "slack", "peer": { "kind": "channel", "id": "C0AFJAGC280" } } },
        { "agentId": "frontend", "match": { "channel": "slack", "peer": { "kind": "channel", "id": "C0AFJAGC280" } } },
        { "agentId": "backend",  "match": { "channel": "slack", "peer": { "kind": "channel", "id": "C0AFJAGC280" } } },
        { "agentId": "devops",   "match": { "channel": "slack", "peer": { "kind": "channel", "id": "C0AFJAGC280" } } },
        { "agentId": "security", "match": { "channel": "slack", "peer": { "kind": "channel", "id": "C0AFJAGC280" } } },
        { "agentId": "design",   "match": { "channel": "slack", "peer": { "kind": "channel", "id": "C0AFJAGC280" } } },
        { "agentId": "research", "match": { "channel": "slack", "peer": { "kind": "channel", "id": "C0AFJAGC280" } } },
        { "agentId": "qa",       "match": { "channel": "slack", "peer": { "kind": "channel", "id": "C0AFJAGC280" } } },

        // ─── #dev-log: 개발팀 ───
        { "agentId": "frontend", "match": { "channel": "slack", "peer": { "kind": "channel", "id": "C0AETKYQP3N" } } },
        { "agentId": "backend",  "match": { "channel": "slack", "peer": { "kind": "channel", "id": "C0AETKYQP3N" } } },
        { "agentId": "devops",   "match": { "channel": "slack", "peer": { "kind": "channel", "id": "C0AETKYQP3N" } } },
        { "agentId": "qa",       "match": { "channel": "slack", "peer": { "kind": "channel", "id": "C0AETKYQP3N" } } },

        // ─── 전용 채널 ───
        { "agentId": "pm",     "match": { "channel": "slack", "peer": { "kind": "channel", "id": "C0AEHKR85S7" } } },
        { "agentId": "pm",     "match": { "channel": "slack", "peer": { "kind": "channel", "id": "C0AF2V9S0QH" } } },
        { "agentId": "design", "match": { "channel": "slack", "peer": { "kind": "channel", "id": "C0AELK28K1T" } } }
    ],

    // ─── Slack 채널 설정 ───
    "channels": {
        "slack": {
            "enabled": true,
            "channels": {
                // collab-bridge
                "C0AFJAGC280": {
                    "allow": true,
                    "requireMention": true,
                    "allowBots": true
                },
                // pm-strategy
                "C0AEHKR85S7": {
                    "allow": true,
                    "requireMention": false
                },
                // dev-log
                "C0AETKYQP3N": {
                    "allow": true,
                    "requireMention": true
                },
                // design-review
                "C0AELK28K1T": {
                    "allow": true,
                    "requireMention": true
                },
                // alert
                "C0AF2V9S0QH": {
                    "allow": true,
                    "requireMention": false
                }
            },
            "dm": {
                "enabled": true,
                "policy": "pairing"
            },
            "actions": {
                "reactions": true,
                "messages": true
            }
        }
    },

    // ─── 세션 설정 ───
    "session": {
        "dmScope": "per-channel-peer"
    },

    // ─── 크론 설정 ───
    "cron": {
        "enabled": true,
        "maxConcurrentRuns": 2
    },

    // ─── Gateway 설정 ───
    "gateway": {
        "mode": "local",
        "auth": {
            "mode": "token",
            "token": "875831d84fc12f1b0bb5f9f3dacad9406aa4ab54e0db24d8"
        }
    },

    // ─── 플러그인 ───
    "plugins": {
        "enabled": true,
        "entries": {
            "slack": { "enabled": true },
            "google-antigravity-auth": { "enabled": true }
        }
    },

    // ─── 에이전트 간 통신 ───
    // 기본값은 OFF. 명시적으로 활성화 + 허용 목록 지정 필요.
    "tools": {
        "agentToAgent": {
            "enabled": true,
            "allow": ["pm", "frontend", "backend", "devops", "security", "design", "research", "qa"]
        }
    },

    // ─── 참고: broadcast는 Slack 미지원 (WhatsApp only) ───
    // Slack에서는 PM 바인딩 + requireMention + mentionPatterns로 라우팅
}
