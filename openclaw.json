{
    // ===========================
    // 개포히치하이커스 — OpenClaw 설정
    // ===========================
    // 멀티에이전트 + Slack 통신 + 모델 계층화

    "agents": {
        "defaults": {
            "model": {
                "primary": "anthropic/claude-opus-4-6",
                "fallbacks": ["anthropic/claude-sonnet-4-5"]
            },
            "contextTokens": 50000,
            "models": {
                "anthropic/claude-opus-4-6": { "alias": "Opus" },
                "anthropic/claude-sonnet-4-5": { "alias": "Sonnet" },
                "google/gemini-3-flash": { "alias": "Flash" }
            },
            // 샌드박싱: 비-메인 세션은 Docker 샌드박스에서 실행
            "sandbox": {
                "mode": "non-main",
                "scope": "agent"
            }
        },

        "list": [
            // ─── PM_Agent: 매니저 ───
            {
                "id": "pm",
                "workspace": "./workspaces/pm",
                "model": {
                    "primary": "anthropic/claude-opus-4-6",
                    "fallbacks": ["anthropic/claude-sonnet-4-5"]
                },
                "groupChat": {
                    "mentionPatterns": ["@PM", "@pm", "PM_Agent"]
                }
            },

            // ─── Frontend_Agent: 프론트엔드 개발자 ───
            {
                "id": "frontend",
                "workspace": "./workspaces/frontend",
                "model": {
                    "primary": "google/gemini-3-flash"
                },
                "tools": {
                    "allow": ["exec", "process", "read", "write", "edit", "browser"]
                },
                "groupChat": {
                    "mentionPatterns": ["@Frontend", "@frontend", "Frontend_Agent"]
                }
            },

            // ─── Backend_Agent: 백엔드 개발자 ───
            {
                "id": "backend",
                "workspace": "./workspaces/backend",
                "model": {
                    "primary": "anthropic/claude-opus-4-6",
                    "fallbacks": ["anthropic/claude-sonnet-4-5"]
                },
                "tools": {
                    "allow": ["exec", "process", "read", "write", "edit"]
                },
                "groupChat": {
                    "mentionPatterns": ["@Backend", "@backend", "Backend_Agent"]
                }
            },

            // ─── DevOps_Agent: 인프라 & 배포 ───
            {
                "id": "devops",
                "workspace": "./workspaces/devops",
                "model": {
                    "primary": "anthropic/claude-sonnet-4-5"
                },
                "tools": {
                    "allow": ["exec", "process", "read", "write", "edit"]
                },
                "groupChat": {
                    "mentionPatterns": ["@DevOps", "@devops", "DevOps_Agent"]
                }
            },

            // ─── Security_Agent: 보안 ───
            {
                "id": "security",
                "workspace": "./workspaces/security",
                "model": {
                    "primary": "anthropic/claude-sonnet-4-5"
                },
                "tools": {
                    "allow": ["exec", "process", "read", "write"]
                },
                "groupChat": {
                    "mentionPatterns": ["@Security", "@security", "Security_Agent"]
                }
            },

            // ─── Design_Agent: 디자이너 ───
            {
                "id": "design",
                "workspace": "./workspaces/design",
                "model": {
                    "primary": "google/gemini-3-flash"
                },
                "tools": {
                    "allow": ["browser", "read", "write"]
                },
                "groupChat": {
                    "mentionPatterns": ["@Design", "@design", "Design_Agent"]
                }
            },

            // ─── Research_Agent: 리서처 & 그로스 ───
            {
                "id": "research",
                "workspace": "./workspaces/research",
                "model": {
                    "primary": "google/gemini-3-flash"
                },
                "tools": {
                    "allow": ["browser", "read", "write"]
                },
                "groupChat": {
                    "mentionPatterns": [
                        "@Research",
                        "@research",
                        "Research_Agent"
                    ]
                }
            },

            // ─── QA_Agent: 품질 관리 ───
            {
                "id": "qa",
                "workspace": "./workspaces/qa",
                "model": {
                    "primary": "anthropic/claude-sonnet-4-5"
                },
                "tools": {
                    "allow": ["exec", "process", "read", "write", "edit"]
                },
                "groupChat": {
                    "mentionPatterns": ["@QA", "@qa", "QA_Agent"]
                }
            }
        ]
    },

    // ─── Slack 채널 → 에이전트 바인딩 ───
    // ⚠️ peer.id에 실제 Slack 채널 ID를 입력하세요 (C로 시작하는 문자열)
    // Slack에서 채널 우클릭 → "Copy link" → URL 끝의 C... 부분이 채널 ID
    "bindings": [
        {
            "agentId": "pm",
            "match": {
                "channel": "slack",
                "peer": { "kind": "channel", "id": "C_PM_STRATEGY" }
            }
        },
        {
            "agentId": "pm",
            "match": {
                "channel": "slack",
                "peer": { "kind": "channel", "id": "C_COLLAB_BRIDGE" }
            }
        },
        {
            "agentId": "pm",
            "match": {
                "channel": "slack",
                "peer": { "kind": "channel", "id": "C_ALERTS" }
            }
        },
        {
            "agentId": "frontend",
            "match": {
                "channel": "slack",
                "peer": { "kind": "channel", "id": "C_DEV_LOGS" }
            }
        },
        {
            "agentId": "design",
            "match": {
                "channel": "slack",
                "peer": { "kind": "channel", "id": "C_DESIGN_REVIEW" }
            }
        }
    ],

    // ─── Slack 채널 설정 ───
    "channels": {
        "slack": {
            "enabled": true,
            // ⚠️ 채널 키도 실제 Slack 채널 ID로 변경 필요
            "channels": {
                "C_COLLAB_BRIDGE": {
                    "allow": true,
                    "requireMention": true,
                    "allowBots": true
                },
                "C_PM_STRATEGY": {
                    "allow": true,
                    "requireMention": false
                },
                "C_DEV_LOGS": {
                    "allow": true,
                    "requireMention": true
                },
                "C_DESIGN_REVIEW": {
                    "allow": true,
                    "requireMention": true
                },
                "C_ALERTS": {
                    "allow": true,
                    "requireMention": false
                }
            },
            "dm": {
                "enabled": true,
                "policy": "pairing"
            },
            "actions": {
                "reactions": true,
                "messages": true
            }
        }
    },

    // ─── 세션 설정 ───
    "session": {
        "dmScope": "per-channel-peer"
    },

    // ─── 크론 설정 ───
    "cron": {
        "enabled": true,
        "maxConcurrentRuns": 2
    }
}
