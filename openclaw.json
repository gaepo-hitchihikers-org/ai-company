{
    // ===========================
    // 개포히치하이커스 — OpenClaw 설정
    // ===========================
    // 에이전트당 1개 Discord Bot = 8개 독립 봇이 Discord에서 실제 팀처럼 소통

    "agents": {
        "defaults": {
            "model": {
                "primary": "google-antigravity/claude-sonnet-4-5",
                "fallbacks": ["google-antigravity/gemini-3-pro-high"]
            },
            "contextTokens": 50000,
            "models": {
                "google-antigravity/claude-sonnet-4-5": { "alias": "Sonnet" },
                "google-antigravity/gemini-3-pro-high": { "alias": "ProHigh" }
            },
            "sandbox": {
                "mode": "off"
            }
        },

        "list": [
            // ─── PM_Agent ───
            {
                "id": "pm",
                "default": true,
                "workspace": "~/.openclaw/workspaces/pm",
                "agentDir": "~/.openclaw/agents/pm/agent",
                "model": {
                    "primary": "google-antigravity/claude-sonnet-4-5",
                    "fallbacks": ["google-antigravity/claude-sonnet-4-5"]
                },
                "identity": { "name": "PM" },
                "tools": {
                    "allow": ["exec", "read", "write", "edit", "browser"]
                },
                "groupChat": {
                    "mentionPatterns": ["@PM", "@pm", "PM"]
                }
            },

            // ─── Frontend_Agent ───
            {
                "id": "frontend",
                "workspace": "~/.openclaw/workspaces/frontend",
                "agentDir": "~/.openclaw/agents/frontend/agent",
                "model": {
                    "primary": "google-antigravity/gemini-3-pro-high"
                },
                "identity": { "name": "Frontend" },
                "tools": {
                    "allow": ["exec", "process", "read", "write", "edit", "browser"]
                },
                "groupChat": {
                    "mentionPatterns": ["@Frontend", "@frontend", "Frontend"]
                }
            },

            // ─── Backend_Agent ───
            {
                "id": "backend",
                "workspace": "~/.openclaw/workspaces/backend",
                "agentDir": "~/.openclaw/agents/backend/agent",
                "model": {
                    "primary": "google-antigravity/claude-sonnet-4-5",
                    "fallbacks": ["google-antigravity/claude-sonnet-4-5"]
                },
                "identity": { "name": "Backend" },
                "tools": {
                    "allow": ["exec", "process", "read", "write", "edit"]
                },
                "groupChat": {
                    "mentionPatterns": ["@Backend", "@backend", "Backend"]
                }
            },

            // ─── DevOps_Agent ───
            {
                "id": "devops",
                "workspace": "~/.openclaw/workspaces/devops",
                "agentDir": "~/.openclaw/agents/devops/agent",
                "model": {
                    "primary": "google-antigravity/claude-sonnet-4-5"
                },
                "identity": { "name": "DevOps" },
                "tools": {
                    "allow": ["exec", "process", "read", "write", "edit"]
                },
                "groupChat": {
                    "mentionPatterns": ["@DevOps", "@devops", "DevOps"]
                }
            },

            // ─── Security_Agent ───
            {
                "id": "security",
                "workspace": "~/.openclaw/workspaces/security",
                "agentDir": "~/.openclaw/agents/security/agent",
                "model": {
                    "primary": "google-antigravity/claude-sonnet-4-5"
                },
                "identity": { "name": "Security" },
                "tools": {
                    "allow": ["exec", "process", "read", "write"]
                },
                "groupChat": {
                    "mentionPatterns": ["@Security", "@security", "Security"]
                }
            },

            // ─── Design_Agent ───
            {
                "id": "design",
                "workspace": "~/.openclaw/workspaces/design",
                "agentDir": "~/.openclaw/agents/design/agent",
                "model": {
                    "primary": "google-antigravity/gemini-3-pro-high"
                },
                "identity": { "name": "Design" },
                "tools": {
                    "allow": ["browser", "read", "write"]
                },
                "groupChat": {
                    "mentionPatterns": ["@Design", "@design", "Design"]
                }
            },

            // ─── Research_Agent ───
            {
                "id": "research",
                "workspace": "~/.openclaw/workspaces/research",
                "agentDir": "~/.openclaw/agents/research/agent",
                "model": {
                    "primary": "google-antigravity/gemini-3-pro-high"
                },
                "identity": { "name": "Research" },
                "tools": {
                    "allow": ["browser", "read", "write"]
                },
                "groupChat": {
                    "mentionPatterns": ["@Research", "@research", "Research"]
                }
            },

            // ─── QA_Agent ───
            {
                "id": "qa",
                "workspace": "~/.openclaw/workspaces/qa",
                "agentDir": "~/.openclaw/agents/qa/agent",
                "model": {
                    "primary": "google-antigravity/claude-sonnet-4-5"
                },
                "identity": { "name": "QA" },
                "tools": {
                    "allow": ["exec", "process", "read", "write", "edit"]
                },
                "groupChat": {
                    "mentionPatterns": ["@QA", "@qa", "QA"]
                }
            }
        ]
    },

    // ─── 바인딩: 에이전트 ↔ Discord 봇 계정 1:1 매핑 ───
    // 각 에이전트가 자신의 Discord Bot으로 메시지를 주고받음
    "bindings": [
        { "agentId": "pm",       "match": { "channel": "discord", "accountId": "pm" } },
        { "agentId": "frontend", "match": { "channel": "discord", "accountId": "frontend" } },
        { "agentId": "backend",  "match": { "channel": "discord", "accountId": "backend" } },
        { "agentId": "devops",   "match": { "channel": "discord", "accountId": "devops" } },
        { "agentId": "security", "match": { "channel": "discord", "accountId": "security" } },
        { "agentId": "design",   "match": { "channel": "discord", "accountId": "design" } },
        { "agentId": "research", "match": { "channel": "discord", "accountId": "research" } },
        { "agentId": "qa",       "match": { "channel": "discord", "accountId": "qa" } }
    ],

    // ─── Discord 설정: 에이전트당 1개 봇 ───
    "channels": {
        "discord": {
            "enabled": true,

            // 8개 Discord Bot 계정 (에이전트당 1개)
            // 각 Bot Token은 환경변수로 관리
            "accounts": {
                "pm":       {},
                "frontend": {},
                "backend":  {},
                "devops":   {},
                "security": {},
                "design":   {},
                "research": {},
                "qa":       {}
            },

            // 다른 봇의 메시지를 수신 (에이전트 간 Discord 소통의 핵심)
            "allowBots": true,

            "groupPolicy": "allowlist",
            "guilds": {
                // Discord 서버 ID — 실제 값으로 교체
                "1471749338538442958": {
                    // 모든 채널 requireMention: true — @mention된 봇만 응답
                    // 채널 권한 설정 없이도 안전 (모든 봇이 모든 채널에 있어도 OK)
                    "requireMention": true,
                    "channels": {
                        // #pm-strategy — PM 전용, 멘션 없이 응답
                        "1471753300507361302": {
                            "allow": true,
                            "requireMention": false
                        },
                        // #collab-bridge
                        "1471753344367333376": {
                            "allow": true
                        },
                        // #dev-log
                        "1471753374121590930": {
                            "allow": true
                        },
                        // #design-review
                        "1471753402471022683": {
                            "allow": true
                        },
                        // #alert
                        "1471753432498180096": {
                            "allow": true
                        }
                    }
                }
            },

            "dm": {
                "enabled": true,
                "policy": "pairing"
            },

            "historyLimit": 30,
            "replyToMode": "first"
        }
    },

    // ─── 세션 설정 ───
    "session": {
        "dmScope": "main"
    },

    // ─── 크론 설정 ───
    "cron": {
        "enabled": true,
        "maxConcurrentRuns": 2
    },

    // ─── Gateway 설정 ───
    "gateway": {
        "mode": "local",
        "auth": {
            "mode": "token",
            "token": "875831d84fc12f1b0bb5f9f3dacad9406aa4ab54e0db24d8"
        }
    },

    // ─── 플러그인 ───
    "plugins": {
        "enabled": true,
        "entries": {
            "discord": { "enabled": true },
            "google-antigravity-auth": { "enabled": true }
        }
    },

    // ─── 에이전트 간 직접 통신: 불필요 (Discord로 소통) ───
    "tools": {
        "agentToAgent": {
            "enabled": false
        }
    }
}
